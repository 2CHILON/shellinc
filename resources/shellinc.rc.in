/* Windows resources for shellinc.exe: the application icon and the version
 * information shown in the file's Properties dialog. CMake generates the real
 * .rc file from this template, so the version comes from CMakeLists.txt. */

1 ICON "@CMAKE_SOURCE_DIR@/assets/icon/shellinc.ico"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "shellinc - a small shell for Windows and Linux"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "shellinc"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "shellinc.exe"
            VALUE "ProductName", "shellinc"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END